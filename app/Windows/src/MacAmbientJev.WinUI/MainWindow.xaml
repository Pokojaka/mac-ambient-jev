<Window x:Class="MacAmbientJev.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MacAmbientJev">
    <Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <TitleBar x:Name="UnifiedTitleBar" Title="MacAmbientJev" Grid.Row="0">
            <TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/AppIcon.ico" ShowAsMonochrome="False" /></TitleBar.IconSource>
            <TitleBar.RightHeader>
                <ContentControl x:Name="Toolbar" IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXS}" VerticalAlignment="Center">
                    <Button x:Name="ImportButton" Style="{StaticResource ToolbarIconButton}" Command="{Binding ImportAudio}" AutomationProperties.Name="音声ファイルを読み込む" ToolTipService.ToolTip="{Binding ImportHelp}">
                        <Path Data="F0 M2,0 H15 L22,7 V12 H20 V8 H14 V2 H4 V22 H12 V24 H2 Z M16,3 V6 H19 Z M18,14 H20 V18 H24 V20 H20 V24 H18 V20 H14 V18 H18 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="SavedSessionsButton" Style="{StaticResource ToolbarIconButton}" IsEnabled="False" Click="OnSavedSessionsClick" AutomationProperties.Name="保存済み録音" ToolTipService.ToolTip="これまでの録音と読み込んだ音声を一覧で表示">
                        <Path Data="M0,10 H2 V14 H0 Z M4,5 H6 V19 H4 Z M8,0 H10 V24 H8 Z M12,7 H14 V17 H12 Z M16,3 H18 V21 H16 Z M20,9 H22 V15 H20 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" Padding="2">
                        <ListView ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSourceChoice, Mode=TwoWay}" IsEnabled="{Binding CanChangeRecordingSelection}" SelectionMode="Single" IsTabStop="False" AutomationProperties.Name="録音元" ToolTipService.ToolTip="{Binding SourceHelp}" ItemContainerStyle="{StaticResource SegmentItem}" Padding="0">
                            <ListView.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="12" /></DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <ComboBox x:Name="DeviceSelector" ItemsSource="{Binding Devices}" DisplayMemberPath="Label" AutomationProperties.Name="デバイス" SelectedItem="{Binding SelectedDeviceChoice, Mode=TwoWay}" IsEnabled="{Binding CanChangeRecordingSelection}" Width="140" MinHeight="32" Padding="8,4" FontSize="12" />
                    <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding RefreshDevices}" AutomationProperties.Name="デバイスを更新" ToolTipService.ToolTip="選択中の音声ソースのデバイス一覧を更新します"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
                    <Grid Background="Transparent" ToolTipService.ToolTip="{Binding RecordingHelp}">
                        <Button x:Name="RecordButton" Style="{StaticResource ToolbarIconButton}" Background="{ThemeResource MacRedBrush}" Foreground="{ThemeResource RecordForegroundBrush}" CornerRadius="16" Command="{Binding ToggleRecording}" AutomationProperties.Name="{Binding RecordingLabel}" ToolTipService.ToolTip="{Binding RecordingHelp}">
                            <Path Data="{Binding RecordingGlyph, Converter={StaticResource MainGlyphConverter}}" Fill="{ThemeResource RecordForegroundBrush}" Width="20" Height="20" Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolbarIconButton}" IsEnabled="False" Click="OnSettingsClick" AutomationProperties.Name="設定" ToolTipService.ToolTip="音声認識モデル、保存先、マイクの設定を表示"><FontIcon Glyph="&#xE713;" FontSize="16" /></Button>
                </StackPanel>
                </ContentControl>
            </TitleBar.RightHeader>
        </TitleBar>
        <StackPanel Grid.Row="1" Padding="{StaticResource MainSectionPadding}" Spacing="{StaticResource SpacingXS}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingSM}">
                <Path Data="{Binding RecordingTone, Converter={StaticResource MainGlyphConverter}}" Fill="{Binding RecordingTone, Converter={StaticResource MainBrushConverter}}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0" />
                <TextBlock Grid.Column="1" Text="{Binding RecordingStatusText}" Style="{StaticResource Callout}" Foreground="{Binding RecordingTone, Converter={StaticResource MainBrushConverter}, ConverterParameter=Text}" MaxLines="2" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding RecordingStatusText}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <ProgressRing IsActive="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" Width="16" Height="16" AutomationProperties.Name="録音操作を処理中" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SilenceWarningText}" Style="{StaticResource WarningCaption}" Visibility="{Binding SilenceWarningText, Converter={StaticResource VisibilityConverter}}" />
            <TextBlock Text="{Binding AudioGapText}" Style="{StaticResource WarningCaption}" Visibility="{Binding AudioGapText, Converter={StaticResource VisibilityConverter}}" />
            <ItemsControl ItemsSource="{Binding LiveFailureNotices}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource WarningCaption}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Visibility="{Binding ProcessingStatusText, Converter={StaticResource VisibilityConverter}}">
                <Path Data="{Binding ProcessingIndicator, Converter={StaticResource MainGlyphConverter}}" Fill="{Binding ProcessingIndicator, Converter={StaticResource MainBrushConverter}}" Width="12" Height="12" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Text="{Binding ProcessingStatusText}" Style="{StaticResource SecondaryCaption}" MaxLines="2" ToolTipService.ToolTip="{Binding ProcessingStatusText}" />
                <ProgressRing Grid.Column="2" Width="12" Height="12" IsActive="{Binding ProcessingIndicator, Converter={StaticResource RunningConverter}}" Visibility="{Binding ProcessingIndicator, Converter={StaticResource RunningVisibilityConverter}}" AutomationProperties.Name="文字起こし処理中" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding IsPreparingModels, Converter={StaticResource VisibilityConverter}}">
                <ProgressRing IsActive="{Binding IsPreparingModels}" Width="12" Height="12" /><TextBlock Text="{Binding PreparationStatusText}" Style="{StaticResource SecondaryCaption}" />
            </StackPanel>
            <TextBlock Text="{Binding PreparationStatusText}" Style="{StaticResource WarningCaption}" Visibility="{Binding IsPreparationFailed, Converter={StaticResource VisibilityConverter}}" />
            <TextBlock Text="{Binding RecoveryStatusText}" Style="{StaticResource SecondaryCaption}" Visibility="{Binding RecoveryStatusText, Converter={StaticResource VisibilityConverter}}" />
            <TextBlock x:Name="ClosingStatus" Text="終了処理中" Style="{StaticResource SecondaryCaption}" Visibility="Collapsed" />
            <StackPanel x:Name="WindowFailureRegion" Visibility="Collapsed" Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Path Data="F0 M7,0 H17 L24,7 V17 L17,24 H7 L0,17 V7 Z M7,6 L12,11 L17,6 L18,7 L13,12 L18,17 L17,18 L12,13 L7,18 L6,17 L11,12 L6,7 Z" Fill="{ThemeResource MacRedBrush}" Width="12" Height="12" Stretch="Uniform" />
                    <TextBlock x:Name="WindowFailureSummary" Grid.Column="1" Style="{StaticResource Caption}" Foreground="{ThemeResource MacRedBrush}" TextWrapping="Wrap" />
                    <ToggleButton x:Name="WindowDetailsToggle" Grid.Column="2" Content="詳細" Click="OnWindowDetailsClick" FontSize="12" Padding="8,0" MinHeight="24" />
                </Grid>
                <ScrollViewer x:Name="WindowFailureScroller" MaxHeight="72" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" IsTabStop="True" AutomationProperties.Name="アプリのエラー"><TextBlock x:Name="WindowFailure" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Caption}" /></ScrollViewer>
            </StackPanel>
            <StackPanel Visibility="{Binding FailureText, Converter={StaticResource VisibilityConverter}}" Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Path Data="F0 M7,0 H17 L24,7 V17 L17,24 H7 L0,17 V7 Z M7,6 L12,11 L17,6 L18,7 L13,12 L18,17 L17,18 L12,13 L7,18 L6,17 L11,12 L6,7 Z" Fill="{ThemeResource MacRedBrush}" Width="12" Height="12" Stretch="Uniform" />
                    <TextBlock Grid.Column="1" Text="{Binding FailureText, Converter={StaticResource FirstLineConverter}}" Style="{StaticResource Caption}" Foreground="{ThemeResource MacRedBrush}" TextWrapping="Wrap" />
                    <ToggleButton x:Name="EngineDetailsToggle" Grid.Column="2" Content="詳細" Click="OnEngineDetailsClick" FontSize="12" Padding="8,0" MinHeight="24" />
                </Grid>
                <ScrollViewer x:Name="EngineFailureScroller" MaxHeight="96" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" IsTabStop="True" AutomationProperties.Name="エンジンのエラー"><TextBlock Text="{Binding FailureText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource Caption}" /></ScrollViewer>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="2" Height="1" Background="{ThemeResource DividerStrokeBrush}" />
        <Grid Grid.Row="3" Padding="{StaticResource MainSectionPadding}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding TranscriptBadge.Text, Converter={StaticResource VisibilityConverter}}" VerticalAlignment="Center">
                <Path Data="{Binding TranscriptBadge.Kind, Converter={StaticResource MainGlyphConverter}}" Fill="{ThemeResource TextFillColorPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" /><TextBlock Text="{Binding TranscriptBadge.Text}" Style="{StaticResource CaptionStrong}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding TranscriptDisplayText}" Style="{StaticResource SecondaryCaption}" Visibility="{Binding TranscriptDisplayText, Converter={StaticResource VisibilityConverter}}" />
                <TextBlock Text="新しい更新があります" Style="{StaticResource SecondaryCaption}" Visibility="{Binding HasNewUpdates, Converter={StaticResource VisibilityConverter}}" />
            </StackPanel>
            <Button x:Name="ReturnToLatestButton" Grid.Column="2" Command="{Binding ReturnToLatest}" ToolTipService.ToolTip="最新の行までスクロールし、自動追従を再開" Visibility="{Binding IsFollowing, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}" Padding="8,4" MinHeight="28">
                <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE70D;" FontSize="12" /><TextBlock Text="{Binding ReturnToLatestLabel}" Style="{StaticResource Caption}" /></StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="4" Height="1" Background="{ThemeResource DividerStrokeBrush}" />
        <Grid Grid.Row="5">
            <ListView x:Name="TranscriptList" ItemsSource="{Binding Rows}" SelectionMode="None" IsItemClickEnabled="False" AutomationProperties.Name="文字起こし" ContainerContentChanging="OnTranscriptContainerContentChanging" Padding="{StaticResource TranscriptPadding}" ItemContainerStyle="{StaticResource TranscriptItem}">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate><DataTemplate>
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="12" Margin="{Binding TopSpacing, Converter={StaticResource TopSpacingConverter}}">
                        <Button Width="42" VerticalAlignment="Top" Style="{StaticResource PlainTimeButton}" Click="OnRowTimeClick" AutomationProperties.Name="{Binding TimeAccessibleName}" ToolTipService.ToolTip="この行の発話文の判定状態と話者区間を表示">
                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource SecondaryCaption}" Typography.NumeralAlignment="Tabular" />
                        </Button>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding HeadingText}" Style="{StaticResource CaptionStrong}" Foreground="{ThemeResource SecondaryTextBrush}" Visibility="{Binding HeadingText, Converter={StaticResource VisibilityConverter}}" />
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{Binding WaitingText}" Style="{StaticResource SecondaryCaption}" Visibility="{Binding WaitingText, Converter={StaticResource VisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="16" Visibility="{Binding IsEmpty, Converter={StaticResource VisibilityConverter}}">
                <Path Data="M0,10 H2 V14 H0 Z M4,5 H6 V19 H4 Z M8,0 H10 V24 H8 Z M12,7 H14 V17 H12 Z M16,3 H18 V21 H16 Z M20,9 H22 V15 H20 Z" Fill="{ThemeResource SecondaryTextBrush}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyTitle}" HorizontalAlignment="Center" Style="{StaticResource Title}" />
                <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource Body}" Foreground="{ThemeResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="480" HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
