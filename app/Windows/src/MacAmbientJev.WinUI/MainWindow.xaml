<Window
    x:Class="MacAmbientJev.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MacAmbientJev">
    <Grid x:Name="Root" Margin="12" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,*">
        <CommandBar x:Name="Toolbar" Grid.Row="0" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="ImportButton" Label="{Binding ImportLabel}" Command="{Binding ImportAudio}" ToolTipService.ToolTip="{Binding ImportDisabledReason}">
                    <AppBarButton.Icon><SymbolIcon Symbol="OpenFile" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="SavedSessionsButton" Label="保存済み録音" IsEnabled="False" Click="OnSavedSessionsClick" ToolTipService.ToolTip="保存済み録音の一覧と処理状態を確認します">
                    <AppBarButton.Icon><SymbolIcon Symbol="Folder" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{Binding StartLabel}" Command="{Binding StartRecording}" ToolTipService.ToolTip="{Binding StartDisabledReason}">
                    <AppBarButton.Icon><SymbolIcon Symbol="Microphone" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{Binding StopLabel}" Command="{Binding StopRecording}" ToolTipService.ToolTip="録音中に停止できます">
                    <AppBarButton.Icon><SymbolIcon Symbol="Stop" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="{Binding RefreshDevicesLabel}" Command="{Binding RefreshDevices}" ToolTipService.ToolTip="選択中の音声ソースのデバイス一覧を更新します">
                    <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="SettingsButton" Label="設定" IsEnabled="False" Click="OnSettingsClick" ToolTipService.ToolTip="一般設定と診断を開きます">
                    <AppBarButton.Icon><SymbolIcon Symbol="Setting" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.PrimaryCommands>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox Header="録音元" ItemsSource="{Binding Sources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedSource, Mode=TwoWay}" IsEnabled="{Binding CanChangeRecordingSelection}" MinWidth="150" />
                    <ComboBox x:Name="DeviceSelector" Header="デバイス" ItemsSource="{Binding Devices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedDevice, Mode=TwoWay}" IsEnabled="{Binding CanChangeRecordingSelection}" MinWidth="200" />
                    <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" VerticalAlignment="Bottom" />
                    <ProgressRing IsActive="{Binding IsImporting}" Width="24" Height="24" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding ImportDisabledReason}" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>
        <StackPanel Grid.Row="1" Spacing="3">
            <TextBlock x:Name="ClosingStatus" Text="終了処理中" Visibility="Collapsed" />
            <TextBlock Text="{Binding StartDisabledReason}" Visibility="{Binding StartDisabledReason, Converter={StaticResource VisibilityConverter}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding RecordingStatusText}" Visibility="{Binding RecordingStatusText, Converter={StaticResource VisibilityConverter}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Presentation.PreparationStatusText}" Visibility="{Binding Presentation.PreparationStatusText, Converter={StaticResource VisibilityConverter}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Presentation.RecoveryStatusText}" Visibility="{Binding Presentation.RecoveryStatusText, Converter={StaticResource VisibilityConverter}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Presentation.ProcessingStatusText}" Visibility="{Binding Presentation.ProcessingStatusText, Converter={StaticResource VisibilityConverter}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SilenceWarningText}" Visibility="{Binding SilenceWarningText, Converter={StaticResource VisibilityConverter}}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AudioGapText}" Visibility="{Binding AudioGapText, Converter={StaticResource VisibilityConverter}}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding LiveFailureNotices}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding BadgeText}" Visibility="{Binding BadgeText, Converter={StaticResource VisibilityConverter}}" />
                <Button x:Name="ReturnToLatestButton" Content="{Binding ReturnToLatestLabel}" Command="{Binding ReturnToLatest}" ToolTipService.ToolTip="文字起こしの表示を最新に追従させます" Visibility="{Binding IsFollowing, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}" />
                <TextBlock Text="新しい更新があります" Visibility="{Binding HasNewUpdates, Converter={StaticResource VisibilityConverter}}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="4">
            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="WindowFailure" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" Visibility="{Binding FailureText, Converter={StaticResource VisibilityConverter}}">
                <TextBlock Text="{Binding FailureText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </StackPanel>
        <Grid Grid.Row="3">
            <ListView x:Name="TranscriptList" ItemsSource="{Binding Rows}" SelectionMode="None" IsItemClickEnabled="False">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" /></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4">
                            <TextBlock Text="{Binding TimeText}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding HeadingText}" Visibility="{Binding HeadingText, Converter={StaticResource VisibilityConverter}}" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{Binding WaitingText}" Visibility="{Binding WaitingText, Converter={StaticResource VisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{Binding IsEmpty, Converter={StaticResource VisibilityConverter}}">
                <TextBlock Text="{Binding EmptyTitle}" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{Binding EmptyDescription}" TextWrapping="Wrap" MaxWidth="480" HorizontalTextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
