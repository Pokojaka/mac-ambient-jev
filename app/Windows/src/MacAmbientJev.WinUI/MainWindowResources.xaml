<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:MacAmbientJev.WinUI">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MacRedBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="MacOrangeBrush" Color="#FF9500" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MacRedBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="MacOrangeBrush" Color="#FF9F0A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MacRedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MacOrangeBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">12</x:Double>
    <x:Double x:Key="SpacingLG">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>
    <Thickness x:Key="MainSectionPadding">16,8</Thickness>
    <Thickness x:Key="TranscriptPadding">16</Thickness>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="CaptionStrong" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="Callout" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /></Style>
    <Style x:Key="Body" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="SecondaryCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SecondaryCaptionStrong" TargetType="TextBlock" BasedOn="{StaticResource CaptionStrong}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WarningCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{ThemeResource MacOrangeBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MainStatusTextStyle" TargetType="local:MainStatusText">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:MainStatusText">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ToneStates">
                        <VisualState x:Name="Secondary"><VisualState.Setters>
                            <Setter Target="StatusText.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="Attention"><VisualState.Setters>
                            <Setter Target="StatusText.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <TextBlock x:Name="StatusText" Text="{TemplateBinding Text}" MaxLines="{TemplateBinding MaxLines}" TextWrapping="{TemplateBinding TextWrapping}"
                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                           Foreground="{TemplateBinding Foreground}" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToolbarIconButton" TargetType="Button">
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="4" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SegmentItem" TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ListViewItem">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver" />
                            <VisualState x:Name="Pressed" />
                            <VisualState x:Name="Selected" />
                            <VisualState x:Name="PointerOverSelected" />
                            <VisualState x:Name="PressedSelected" />
                        </VisualStateGroup>
                        <!-- Selection remains visible even when the common state becomes Disabled. -->
                        <VisualStateGroup x:Name="SelectionStates">
                            <VisualState x:Name="SelectionVisible">
                                <VisualState.StateTriggers><StateTrigger IsActive="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="Segment.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                                    <Setter Target="Segment.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="EnabledStates">
                            <VisualState x:Name="Enabled">
                                <VisualState.StateTriggers><StateTrigger IsActive="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" /></VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.StateTriggers><local:MainFalseStateTrigger Value="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" /></VisualState.StateTriggers>
                                <VisualState.Setters><Setter Target="Segment.Opacity" Value="0.4" /></VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="Segment" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TranscriptItem" TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PlainTimeButton" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Segoe Fluent Icons has no waveform; each instance parses its own Geometry, so none is shared between elements. -->
    <Style x:Key="WaveformIcon" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
            <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                <PathIcon Data="M1,10.5 A1,1 0 0 1 3,10.5 V13.5 A1,1 0 0 1 1,13.5 Z M5,6.5 A1,1 0 0 1 7,6.5 V17.5 A1,1 0 0 1 5,17.5 Z M9,2.5 A1,1 0 0 1 11,2.5 V21.5 A1,1 0 0 1 9,21.5 Z M13,7.5 A1,1 0 0 1 15,7.5 V16.5 A1,1 0 0 1 13,16.5 Z M17,4.5 A1,1 0 0 1 19,4.5 V19.5 A1,1 0 0 1 17,19.5 Z M21,9.5 A1,1 0 0 1 23,9.5 V14.5 A1,1 0 0 1 21,14.5 Z" />
            </Viewbox>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
