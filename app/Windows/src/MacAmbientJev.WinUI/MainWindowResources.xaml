<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MacRedBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="MacOrangeBrush" Color="#FF9500" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MacRedBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="MacOrangeBrush" Color="#FF9F0A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MacRedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="MacOrangeBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DividerStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RecordForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <SolidColorBrush x:Key="RecordForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DividerStrokeBrush" Color="{ThemeResource DividerStrokeColorDefault}" />
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingSM">8</x:Double>
    <x:Double x:Key="SpacingMD">12</x:Double>
    <x:Double x:Key="SpacingLG">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>
    <Thickness x:Key="MainSectionPadding">16,8</Thickness>
    <Thickness x:Key="TranscriptPadding">16</Thickness>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="CaptionStrong" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="Callout" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /></Style>
    <Style x:Key="Body" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /></Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="SecondaryCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WarningCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="Foreground" Value="{ThemeResource MacOrangeBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ToolbarIconButton" TargetType="Button">
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="4" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SegmentItem" TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ListViewItem">
                <Grid>
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver" />
                        <VisualState x:Name="Pressed" />
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Segment.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Selected"><VisualState.Setters>
                            <Setter Target="Segment.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Setter Target="Segment.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="PointerOverSelected"><VisualState.Setters>
                            <Setter Target="Segment.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Setter Target="Segment.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        </VisualState.Setters></VisualState>
                        <VisualState x:Name="PressedSelected"><VisualState.Setters>
                            <Setter Target="Segment.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Setter Target="Segment.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <Border x:Name="Segment" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TranscriptItem" TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PlainTimeButton" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
